# Скопируйте в .env и замените значения: cp .env.example .env
# .env не попадает в git.

# PostgreSQL
POSTGRES_USER=platforma
# Только латинские буквы и цифры: пароль подставляется в адрес базы
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platforma
# Порт базы на вашем компьютере (для локальной разработки и psql)
POSTGRES_PORT=5432

# Адрес базы для web при запуске на вашем компьютере (npm run dev).
# Внутри docker compose адрес подставляется автоматически (хост db).
DATABASE_URL=postgres://platforma:change-me@localhost:5432/platforma

# Секрет для подписи сессий Auth.js. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=change-me

# Первый администратор (создаётся командой npm run seed:admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too
ADMIN_FIRST_NAME=Имя
ADMIN_LAST_INITIAL=Ф

# Папка для картинок задач. Для локальной разработки можно не задавать
# (по умолчанию папка media/ в корне проекта). В docker compose - /data/media.
# MEDIA_DIR=
